{
  "name": "cuecard",
  "version": "1.3.0",
  "description": "Responsible live preparation assistant with context-grounded speaking cues",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "check": "node scripts/check-syntax.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "node --test tests/*.test.cjs",
    "build:mac": "electron-builder --mac dmg --arm64 --x64 --publish never",
    "build:win": "electron-builder --win nsis --x64 --publish never"
  },
  "author": "MohanSai9257",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10"
  },
  "dependencies": {
    "mammoth": "1.13.0",
    "pdf-parse": "2.4.5"
  },
  "build": {
    "appId": "com.cuecard.desktop",
    "productName": "CueCard",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "providers.js",
      "ai-client.js",
      "audio-recorder.js",
      "audio-worklet.js",
      "resume-parser.js",
      "preload.js",
      "renderer.js",
      "live-transcription.js",
      "secure-store.js",
      "workspace.js",
      "workspace.css",
      "index.html",
      "styles.css",
      "assets/icon.png",
      "assets/system-audio-*",
      "!node_modules/mammoth/bin/**",
      "!node_modules/argparse/**",
      "!node_modules/mammoth/node_modules/argparse/**"
    ],
    "asar": true,
    "beforePack": "scripts/build-audio.cjs",
    "asarUnpack": [
      "assets/system-audio-*"
    ],
    "mac": {
      "identity": "-",
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "artifactName": "CueCard-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "CueCard uses your microphone when you enable My Mic.",
        "NSAudioCaptureUsageDescription": "CueCard captures call audio when you enable System Audio.",
        "NSScreenCaptureUsageDescription": "CueCard captures a screenshot only when you choose Analyze screen. System audio may require a separate macOS recording permission."
      }
    },
    "win": {
      "icon": "assets/icon.png",
      "artifactName": "CueCard-${version}-windows-${arch}.${ext}",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
